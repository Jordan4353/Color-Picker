        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": \"{{ $fromAI('name', 'Label name') }}\",\n  \"color\": {\n    \"backgroundColor\": \"{{ $fromAI('backgroundColor', 'Hex background color') }}\",\n    \"textColor\": \"{{ $fromAI('textColor', 'Hex text color') }}\"\n  }\n}",
