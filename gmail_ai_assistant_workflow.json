        "labelIds": "={{ $fromAI('addLabelIds', 'Array of label IDs to add') }}",
        "removeLabelIds": "={{ $fromAI('removeLabelIds', 'Array of label IDs to remove, e.g. [\"INBOX\"] to archive') }}"
      },
      "id": "gmail-label-tool",
      "name": "Gmail Label Tool",
